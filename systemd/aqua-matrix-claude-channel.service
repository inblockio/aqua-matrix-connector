[Unit]
Description=Aqua Matrix claude-channel (LLM bridge — DM in, `claude -p` reply out)
Documentation=https://github.com/inblockio/aqua-matrix-agent
After=network-online.target
Wants=network-online.target
# Start limit DISABLED (2026-09-27). The old 10-starts-in-300s limit was a
# trap, not a guard: ten 5s restarts fit inside 300s, so a network outage of a
# few minutes left the unit dead for good ("Start request repeated too
# quickly"). The crash-loop guard is now the progressive backoff in [Service]
# (RestartSteps/RestartMaxDelaySec). Kept in [Unit], where modern systemd reads
# it; [Service] placement is silently ignored.
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=%h/aqua-matrix-agent
# Forward CONTEXT_WINDOW for consistency with the heartbeat (status payloads
# only matter on the heartbeat side, but keep envs aligned).
Environment=CONTEXT_WINDOW=1000000
# claude is at ~/.local/bin/claude; the daemon also resolves this dynamically
# but setting PATH lets a future PATH-based claude lookup work too.
Environment=PATH=%h/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
# Per-instance config (AGENT_TARGET, optional MATRIX_URL/SIWX_URL overrides):
# the daemon loads this `.env` at startup. This file is machine-local and NOT in
# the repo — copy `.env.example` and fill in your own target. Multi-agent: each
# instance points AGENT_ENV_FILE at its own file.
Environment=AGENT_ENV_FILE=%h/.aqua-matrix-claude-channel/agent.env
# Reference example backend (was `aqua-matrix-agent --claude-channel` before
# the workspace split). The unit name stays `aqua-matrix-claude-channel` so
# `#shell respawn-channel`, the registry role, and skills are unaffected.
# The `aqua-matrix-claude-p` crate lives in the sibling ~/aqua-agents
# workspace (path-depending on this repo's relay crate), so the canonical
# binary is built THERE: `cd ~/aqua-agents && cargo build -p aqua-matrix-claude-p`.
# WorkingDirectory stays in this repo so the relative --key-file resolves.
ExecStart=%h/aqua-agents/target/debug/aqua-matrix-claude-p --key-file claude-channel.pem --store-dir %h/.aqua-matrix-claude-channel
Restart=always
# Progressive backoff (2026-09-27, systemd >= 254): 5s -> 60s over 8 steps, so a
# one-off crash comes back in 5s while a sustained failure (outage, bad
# deploy) settles at one attempt per minute, forever.
RestartSec=5s
RestartSteps=8
RestartMaxDelaySec=60s
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
